# Salin file ini menjadi .env.local lalu isi.

# Supabase: Project Settings → API (atau tombol "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-publishable-atau-anon-key

# Asisten AI (Fase 2): buat key di https://console.anthropic.com → API Keys
# RAHASIA: jangan dibagikan / di-commit / ditempel di chat.
ANTHROPIC_API_KEY=

# Opsional. Default: claude-opus-5-5 (paling cerdas).
# Untuk biaya ±50% lebih rendah: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# Opsional: low | medium (default) | high — kedalaman analisis vs biaya & kecepatan
# ANTHROPIC_EFFORT=medium
